<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- All validator output goes to stderr.
             BenchExec reads stdout exclusively for the verdict line. -->
        <Console name="StdErr" target="SYSTEM_ERR">
            <PatternLayout pattern="%-5level %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Default level WARN; raised to DEBUG by Main when verbose mode is requested. -->
        <Root level="warn">
            <AppenderRef ref="StdErr"/>
        </Root>
    </Loggers>
</Configuration>
