<?xml version="1.0" encoding="UTF-8" ?>

<!--
  BenchExec benchmark definition for violation witness validation.

  This definition runs the jLISA Witness Validator against a set of Java
  violation witnesses from the SV-COMP benchmark repository.

  Resource limits:
    - 90 seconds CPU time (BenchExec SV-COMP default for witness validation)
    - 7 GB memory

  Usage:
    benchexec benchexec/validator-violation-witnesses.xml \
      -t <tool-info-module> -o results/

  See https://github.com/sosy-lab/benchexec for BenchExec documentation.
-->

<benchmark tool="jlisa-witness-validator"
           displayName="jLISA Violation Witness Validator"
           timelimit="90s"
           memlimit="7 GB"
           cpuCores="1">

  <option name="--witness">{witnessfile}</option>
  <option name="--benchmark-dir">{inputfile_path}</option>

  <!-- Add --java <path> here if benchmarks must run on a specific Java version, e.g.: -->
  <!-- <option name="--java">/usr/lib/jvm/java-8-openjdk-amd64/bin/java</option> -->

  <rundefinition name="violation-witnesses">
    <tasks name="sv-benchmarks-java-violation">
      <!-- Replace with actual witness task set from sv-benchmarks/java/ -->
      <includesfile>../sv-benchmarks/java/violations.set</includesfile>
      <propertyfile>../sv-benchmarks/java/properties/assert_java.prp</propertyfile>
    </tasks>
  </rundefinition>

  <columns>
    <column title="status" />
    <column title="cputime" />
    <column title="memory" />
  </columns>

</benchmark>
